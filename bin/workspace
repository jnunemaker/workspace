#!/bin/sh
# workspace — CLI tool for managing development workspaces.
#
# Subcommands:
#   bootstrap  Initialize a workspace (symlinks, deps, DB)
#   run        Start the dev server
#   archive    Tear down a workspace (kill processes, drop DBs)
#   info       Show the detected workspace identity and resources
#   prune      Clean resources for Git worktrees removed externally
#   update     Pull latest from GitHub and reinstall
#   version    Print the current version
#
# Install:
#   curl -fsSL https://raw.githubusercontent.com/jnunemaker/workspace/main/install.sh | bash

set -e

if [ -z "${WORKSPACE_HOME:-}" ]; then
  _workspace_home_candidate=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
  if [ -f "$_workspace_home_candidate/lib/common.sh" ]; then
    WORKSPACE_HOME="$_workspace_home_candidate"
  else
    WORKSPACE_HOME="${HOME:-}/.workspace"
  fi
  unset _workspace_home_candidate
fi
VERSION=$(git -C "$WORKSPACE_HOME" log -1 --format="%h (%cs)" 2>/dev/null || echo "unknown")

usage() {
  echo "workspace $VERSION"
  echo ""
  echo "Usage: workspace <command>"
  echo ""
  echo "Commands:"
  echo "  init       Set up a project for workspace support"
  echo "  bootstrap  Initialize a workspace (symlinks, deps, DB)"
  echo "  run        Start the dev server"
  echo "  archive    Tear down a workspace (kill processes, drop DBs)"
  echo "  info       Show provider, identity, URL, and allocated ports"
  echo "  prune      Clean resources for removed Git worktrees"
  echo "  update     Pull latest from GitHub and reinstall"
  echo "  version    Print the current version"
  echo ""
  echo "Run 'workspace <command> --help' for more information."
}

case "${1:-}" in
  init)
    shift
    exec sh "$WORKSPACE_HOME/lib/init.sh" "$@"
    ;;
  bootstrap)
    shift
    exec sh "$WORKSPACE_HOME/lib/bootstrap.sh" "$@"
    ;;
  run)
    shift
    exec sh "$WORKSPACE_HOME/lib/run.sh" "$@"
    ;;
  archive)
    shift
    exec sh "$WORKSPACE_HOME/lib/archive.sh" "$@"
    ;;
  info)
    shift
    exec sh "$WORKSPACE_HOME/lib/info.sh" "$@"
    ;;
  prune)
    shift
    exec sh "$WORKSPACE_HOME/lib/prune.sh" "$@"
    ;;
  update)
    shift
    if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
      cat <<'EOF'
Usage: workspace update

Updates the shared Workspace CLI and refreshes any installed Claude Code or
Codex Workspace skill. It does not change files in application repositories.
Run workspace init separately to refresh generated project files.
EOF
      exit 0
    fi
    echo "Checking for workspace CLI updates..."
    if [ -d "$WORKSPACE_HOME/.git" ]; then
      git -C "$WORKSPACE_HOME" pull origin main --quiet
    else
      # Re-install from scratch
      curl -fsSL https://raw.githubusercontent.com/jnunemaker/workspace/main/install.sh | bash
      exit $?
    fi
    sh "$WORKSPACE_HOME/lib/install_skill.sh"
    NEW_VERSION=$(git -C "$WORKSPACE_HOME" log -1 --format="%h (%cs)" 2>/dev/null || echo "unknown")
    if [ "$NEW_VERSION" = "$VERSION" ]; then
      echo "workspace already up to date at $NEW_VERSION"
    else
      echo "workspace updated to $NEW_VERSION"
    fi
    ;;
  version)
    shift
    if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
      cat <<'EOF'
Usage: workspace version

Prints the installed Workspace version.
EOF
      exit 0
    fi
    echo "workspace $VERSION"
    ;;
  --version|-v)
    echo "workspace $VERSION"
    ;;
  help|--help|-h|"")
    usage
    ;;
  *)
    echo "workspace: unknown command '$1'" >&2
    echo "" >&2
    usage >&2
    exit 1
    ;;
esac
